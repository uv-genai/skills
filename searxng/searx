#!/usr/bin/env bash
# SearXNG search CLI wrapper
# Usage: searx "<query>" [-n N] [-c category] [-l language] [-t time-range]
set -euo pipefail

SEARXNG_URL="${SEARXNG_URL:-http://strix-halo-1.local:8888}"
RESULTS=10
CATEGORY="general"
LANGUAGE="en"
TIME_RANGE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n) RESULTS="$2"; shift 2 ;;
    -c) CATEGORY="$2"; shift 2 ;;
    -l) LANGUAGE="$2"; shift 2 ;;
    -t|--time-range) TIME_RANGE="$2"; shift 2 ;;
    -h|--help)
      echo "Usage: searx \"<query>\" [-n N] [-c category] [-l language] [-t time-range]"
      echo ""
      echo "Options:"
      echo "  -n N          Number of results (default: 10)"
      echo "  -c category   Search category (general, news, images, videos, files, it, science, social media)"
      echo "  -l language   Language code (default: en)"
      echo "  -t time-range Filter by age (day, week, month, year)"
      echo "  -h            Show this help"
      exit 0
      ;;
    *) QUERY="$1"; shift ;;
  esac
done

if [[ -z "${QUERY:-}" ]]; then
  echo "Error: query is required" >&2
  echo "Usage: searx \"<query>\" [-n N] [-c category] [-l language] [-t time-range]" >&2
  exit 1
fi

CURL_ARGS=(
  -sf --max-time 15
  "${SEARXNG_URL}/search"
  --data-urlencode "q=${QUERY}"
  --data-urlencode "categories=${CATEGORY}"
  -d "language=${LANGUAGE}"
  -d "format=json"
)

if [[ -n "${TIME_RANGE}" ]]; then
  CURL_ARGS+=( -d "time_range=${TIME_RANGE}" )
fi

RESPONSE=$(curl "${CURL_ARGS[@]}" 2>/dev/null) || { echo "Error: failed to reach SearXNG at ${SEARXNG_URL}" >&2; exit 1; }

echo "${RESPONSE}" | jq -c ".results[:${RESULTS}] | .[] | {title, url, snippet: (.snippet // \"\")}"
